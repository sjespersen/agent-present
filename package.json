{
  "name": "agent-present-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Agent Present \u2014 a presentation layer for AI agents. Don't make me read.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/terminal",
    "packages/pi"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./packages/pi/dist/index.js"
    ]
  },
  "scripts": {
    "build": "npm run build -w @agent-present/core && npm run build -w @agent-present/terminal && npm run build -w @agent-present/pi",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "gallery": "node --experimental-strip-types scripts/gallery.ts",
    "demo": "node packages/terminal/dist/cli.js",
    "check": "npm run typecheck && npm run test && npm run build",
    "spec": "node --experimental-strip-types scripts/generate-schema.ts && node --experimental-strip-types scripts/generate-spec.ts",
    "pi:screens": "node --experimental-strip-types scripts/pi-screenshots.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@earendil-works/pi-tui": "^0.86.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
